# THE HOUSE — environment template (tracked; NO real values here).
#
# Copy to .env and fill in the house's OWN credentials. .env is gitignored;
# never commit real secrets. This template mirrors .env's canonical layout:
# every value belongs to THE HOUSE, nothing inherited from other projects.

# --- 1. rail credential — house's own CDP facilitator key (Base mainnet) ---
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- 2. receiving wallet (EVM) — x402 USDC payments land here ------------
# the-house ACP agent wallet (Privy smart wallet). Generate fresh; never
# reuse another project's receiving address.
HOUSE_WALLET=

# --- 3. the-house agent (ACP / Virtuals identity) ------------------------
HOUSE_AGENT_ID=
HOUSE_AGENT_NAME=the-house
HOUSE_BUILDER_CODE=
HOUSE_SOL_WALLET=

# --- 4. chain / product references (public constants, Base mainnet) ------
HOUSE_NETWORK=eip155:8453
HOUSE_USDC_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# the-house agent token on Base (Virtuals)
HOUSE_TOKEN_RTX=
HOUSE_VIRTUAL_AGENT_ID=

# --- 5. runtime overrides (optional) --------------------------------------
# HOUSE_BASE_PRICE=0.01
# HOUSE_SERVICE_NAME=the-house
# HOUSE_PORT=8090
# HOUSE_MEMORY_DB=/absolute/path/to/memory.db

# --- 6. deletion harness — flip to 1 to prove memory is load-bearing ------
# SIBYL_DISABLED=1
