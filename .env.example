"""THE HOUSE — environment template.

Copy to .env and fill in the house's OWN credentials (nothing inherited from
other projects). .env is gitignored; never commit real secrets.
"""
# --- x402 rail (Base mainnet, Coinbase X402 facilitator) ---
# House's own CDP API key (create at Coinbase Developer Platform).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Receiving wallet for x402 payments (Base mainnet, USDC). Generate fresh.
HOUSE_WALLET=

# --- optional overrides ---
# HOUSE_BASE_PRICE="$0.01"
# HOUSE_SERVICE_NAME="the-house"
# HOUSE_NETWORK="eip155:8453"
# HOUSE_PORT="8090"

# --- deletion harness (flip to 1 to prove memory is load-bearing) ---
# SIBYL_DISABLED=1
